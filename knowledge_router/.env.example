API_BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here

MATCH_MODEL=google/gemini-3.1-flash-lite   # 在线匹配；未设时回退 INIT_MODEL / ANSWER_MODEL
IMPORT_MODEL=google/gemini-3.1-flash-lite   # 批量导入 md；未设时回退 INIT_MODEL
# 若沿用 model_router 的 .env，只配 INIT_MODEL 也可（knowledge_router 会自动识别）
MATCH_MAX_TOKENS=8          # 逻辑目标 8；上游若要求最小 16，代码会自动 clamp
MATCH_TEMPERATURE=0
MAX_TOKENS=4096

MOCK_LLM=0
USE_CONTENT_PARTS=0
USE_MAX_COMPLETION_TOKENS=0
DISABLE_THINKING=1
