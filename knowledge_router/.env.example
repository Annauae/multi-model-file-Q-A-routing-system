# OpenRouter — google/gemini-3.1-flash-lite
# https://openrouter.ai/docs
API_BASE_URL=https://openrouter.ai/api/v1

API_KEY=your_openrouter_api_key_here

ROUTER_MODEL=google/gemini-3.1-flash-lite
INIT_MODEL=google/gemini-3.1-flash-lite
ANSWER_MODEL=google/gemini-3.1-flash-lite

# 可选：单独指定匹配模型；未设置时使用 ROUTER_MODEL
# MATCH_MODEL=google/gemini-3.1-flash-lite

# Content limits
MAX_FILE_CHARS=120000
MAX_TOKENS=4096
ANSWER_MAX_TOKENS=512
MAX_ANSWER_CHARS=0

USE_MAX_COMPLETION_TOKENS=0
USE_CONTENT_PARTS=0

DISABLE_THINKING=1
ENABLE_THINKING=0

ANSWER_WITH_IMAGES=1
MAX_ANSWER_IMAGES=0

MIN_ROUTE_QUESTIONS=10
MAX_ROUTE_QUESTIONS=15

AGENT_MAX_WORKERS=8

LLM_TEMPERATURE=0

MOCK_LLM=0

# optional data paths
# DATA_ROOT=D:/agent-group/knowledge_router
# KB_CONFIG_PATH=D:/agent-group/knowledge_router/config/knowledge_bases.json
# FILES_ROOT=D:/agent-group/knowledge_router/files
