# Router 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
#
# ── 与「设置」页的关系 ─────────────────────────────────────
# · 模型 API 地址、Key、模型名、Profile、RAG 槽位 → 运行时以 PostgreSQL app_settings 为准（设置页保存）。
# · 下方 API_* / MATCH_MODEL / RAG_*_MODEL 等仅在「PG 尚无对应配置」时，作为 ModelsStore / RagModelsStore 的初始默认值。
# · 若已有 config/*.json，首次启动 ensureJsonSeeded 会导入 PG，通常比 .env 模型变量更优先。
# · 改 .env 里的模型变量不会自动覆盖已保存的设置；需清空 PG 对应 key 或改设置页。
#
# 代码来源：server/src/config.js（loadSettings）

# ── 必填 ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/router

# ── HTTP 服务（index.js 直接读 process.env）──────────────────
PORT=8002
# HOST=0.0.0.0

# ── 数据目录（默认 DATA_ROOT=Router 包根，FILES_ROOT={DATA_ROOT}/files）──
# DATA_ROOT=
# FILES_ROOT=

# ── PostgreSQL ─────────────────────────────────────────────
DATABASE_POOL_SIZE=20
# TEST_DATABASE_URL=       # 仅 npm test / dbSetup 使用；未设时回退 DATABASE_URL
# SKIP_JSON_SEED=1         # 兼容旧环境；当前默认无本地 JSON 种子，可忽略

# 首次建库（可选）：npm run db:setup -w server
# 脚本读取 PGUSER / PGPASSWORD / POSTGRES_PASSWORD / PGHOST / PGPORT / PGDATABASE

# ── 流式调试超时（始终读 env，单位：秒）────────────────────
# 默认 60。用于 POST /ask/confidence/stream 等服务端 AbortController；
# 超时后该次请求失败（SSE error），不会重启进程。
# DEBUG_REQUEST_TIMEOUT_S=60

# ── LLM 全局开关（始终读 env，影响 LLMClient 行为）──────────
# MOCK_LLM=0               # 1=不调真实 API，本地子串 mock（开发/测试）
# USE_MAX_COMPLETION_TOKENS=0   # 1=请求体用 max_completion_tokens（部分云厂商）
# USE_CONTENT_PARTS=0      # 1=user 消息改为 content parts 数组（多模态兼容）

# 思考链全局默认（设置页 Profile 选「默认」时，LLMClient 仍可能参考此处）：
# DISABLE_THINKING=1       # 默认 1=关闭；ENABLE_THINKING 显式 1/0 可覆盖
# ENABLE_THINKING=
# REASONING_EFFORT=        # low | medium | high（可选）

# ── 模型/API 种子默认值（PG 无 app_settings 时写入；日常改设置页即可）──
# API_BASE_URL=https://api.openai.com/v1
# API_KEY=
# ARK_API_KEY=             # 与 API_KEY 二选一
# MATCH_MODEL=gpt-4.1-mini
# IMPORT_MODEL=            # 未设则同 MATCH_MODEL
# MAX_TOKENS=4096
# CONFIDENCE_MAX_TOKENS=512
# CONFIDENCE_TOP_K=5
# MATCH_TEMPERATURE=0

# ── RAG / Weaviate（基础设施与检索算法，始终读 env）────────
# WEAVIATE_URL=            # 空且 MOCK_WEAVIATE=0 → 自动用内存 MockWeaviateStore
# WEAVIATE_API_KEY=
# WEAVIATE_CLASS=FaqSearchDoc
# MOCK_WEAVIATE=0          # 1=强制内存 mock，不连真实 Weaviate

# RAG 检索融合参数（RagRetriever 读 settings，非设置页）
# RAG_VECTOR_TOP_K=30
# RAG_KEYWORD_TOP_K=30
# RAG_RRF_K=60
# RAG_EVAL_HOLDOUT_PER_ITEM=1   # 索引 rebuild 时每条 FAQ 预留的 holdout 变体数（indexer.js）

# Embedding 批处理（索引 rebuild 时）
# DISABLE_API_EMBEDDING=0  # 1=不调 Embedding API，用本地 hash 向量
# HASH_EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_SLEEP_SEC=0.25
# EMBEDDING_MAX_CHARS=6000

# RAG 模型槽位种子（PG 无 rag_models 时；日常改设置页 RAG Tab）
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ── PDF 提取（Python，server/pdf_extract/）────────────────
# 需安装：pip install -r server/pdf_extract/requirements.txt
# 使用 Router/.env 中的 API_KEY / API_BASE_URL；VLM 模型见设置页 pdf_vlm 槽位。
