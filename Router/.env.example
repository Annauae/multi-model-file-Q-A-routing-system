# ── 模型配置 ──────────────────────────────────────────────
# API 地址、Key、模型名、思考模式等，均在控制台「设置」页配置并保存。
# 对应文件：config/match_profiles.json（回答模型）、config/models.json（FAQ / 文档提取）。
# 首次部署若上述文件不存在，服务会用下方可选默认值生成初始配置；日常使用可忽略。

# API_BASE_URL=https://api.openai.com/v1
# API_KEY=
# MATCH_MODEL=gpt-4.1-mini
# IMPORT_MODEL=gpt-4.1-mini

# ── 全局运行参数（管理员 / 部署时可调）────────────────────

# 思考模式全局默认（设置里选「默认」时生效；Ollama 建议在设置里单独选「关闭」）
DISABLE_THINKING=1

# 1=本地 mock，不调真实 API（开发调试用）
MOCK_LLM=0

# 调试问答流式请求超时（秒），超时后服务自动重启
DEBUG_REQUEST_TIMEOUT_S=180

# 部分云厂商兼容开关
USE_MAX_COMPLETION_TOKENS=0
USE_CONTENT_PARTS=0

# 可选：默认 Top K、Token 上限等（多数已在设置页按模型单独配置）
# CONFIDENCE_TOP_K=5
# CONFIDENCE_MAX_TOKENS=512
# MAX_TOKENS=4096
# MATCH_TEMPERATURE=0

# 可选：数据目录（默认 knowledge_router 包内 config/、files/）
# DATA_ROOT=
# FILES_ROOT=
