# OpenRouter — google/gemini-3.1-flash-lite
# https://openrouter.ai/docs
API_BASE_URL=https://openrouter.ai/api/v1

API_KEY=your_openrouter_api_key_here

ROUTER_MODEL=google/gemini-3.1-flash-lite
INIT_MODEL=google/gemini-3.1-flash-lite
ANSWER_MODEL=google/gemini-3.1-flash-lite

# Content limits
MAX_FILE_CHARS=120000
MAX_TOKENS=4096
ANSWER_MAX_TOKENS=512
# 0 = 不限制回答汉字数；>0 时在 prompt 与兜底逻辑中截断
MAX_ANSWER_CHARS=0

USE_MAX_COMPLETION_TOKENS=0
USE_CONTENT_PARTS=0

# 回答阶段：将完整 knowledge.md 放入 system 提示，并按文档顺序附带插图（需 vision 模型）
ANSWER_WITH_IMAGES=1
# 0 = 不限制插图数量；>0 时最多发送 N 张
MAX_ANSWER_IMAGES=0

# Gemini 2.5：DISABLE_THINKING=1（直连 Google 时由 llm_client 注入 reasoning_effort=none）
DISABLE_THINKING=1
ENABLE_THINKING=0

# Initialization question count
MIN_ROUTE_QUESTIONS=10
MAX_ROUTE_QUESTIONS=15

# Max concurrent agent LLM calls during /ask (when multiple target_agents)
AGENT_MAX_WORKERS=8

# tests/dev
MOCK_LLM=0

# optional data paths (useful for tests / custom deployments)
# DATA_ROOT=D:/model_router
# AGENTS_CONFIG_PATH=D:/model_router/config/agents.json
# FILES_ROOT=D:/model_router/files

# --- 直连 Google Gemini（OpenAI 兼容）---
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API_KEY=your_gemini_api_key_here
# ROUTER_MODEL=gemini-2.5-flash-lite
# INIT_MODEL=gemini-2.5-flash-lite
# ANSWER_MODEL=gemini-2.5-flash-lite

# --- 火山方舟（doubao）---
# API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# API_KEY=your_ark_api_key_here
# ROUTER_MODEL=ep-xxxxxxxx
# INIT_MODEL=ep-xxxxxxxx
# ANSWER_MODEL=ep-xxxxxxxx
